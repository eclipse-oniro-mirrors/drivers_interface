/**
 * @addtogroup HdiPcie
 * @{
 *
 * @brief Provides data types for PCIe device scanning and driver loading.
 *
 * @since 7.0
 * @version 1.0
 */

/**
 * @file PcieTypes.idl
 *
 * @brief Defines data types used by the PCIe HDI APIs.
 *
 * @since 7.0
 * @version 1.0
 */

/**
 * @brief Defines the package path of the PCIe HDI data types.
 *
 * @since 7.0
 * @version 1.0
 */
package ohos.hdi.pcie.v1_0;

/**
 * @brief Describes a PCIe device scanned by the PCIe host.
 *
 * @since 7.0
 * @version 1.0
 */
struct PcieDeviceInfo {
    String boardId;       /**< PCIe board BDF identifier. */
    String sysfsPath;     /**< sysfs path of the PCIe device. */
    String vendorId;      /**< PCIe vendor ID. */
    String deviceId;      /**< PCIe device ID. */
    String classCode;     /**< PCIe device class code. */
    String modalias;      /**< PCIe modalias used for driver matching. */
    boolean isModaliasValid; /**< Whether the PCIe modalias is valid. */
    String boundDriver;   /**< Name of the currently bound kernel driver. */
};

/**
 * @brief Defines the common identity of a PCIe driver.
 *
 * @since 7.0
 * @version 1.0
 */
struct PcieDriverIdentity {
    String boardId;       /**< Target PCIe board BDF identifier. */
    String driverPath;    /**< Path of the driver file. */
    String moduleName;    /**< Kernel module name. */
};

/**
 * @brief Defines a driver loading request for a PCIe device.
 *
 * @since 7.0
 * @version 1.0
 */
struct PcieDriverLoadItem {
    struct PcieDriverIdentity driverIdentity; /**< Target driver identity. */
    String options;                           /**< Driver loading options. */
};

/**
 * @brief Describes the loading result of a single driver.
 *
 * @since 7.0
 * @version 1.0
 */
struct PcieDriverLoadResult {
    struct PcieDriverIdentity driverIdentity; /**< Loaded driver identity. */
    int statusCode;                            /**< PCIe business status code for this loading request. */
    String statusMessage;                      /**< Human-readable loading status message. */
};

/** @} */
