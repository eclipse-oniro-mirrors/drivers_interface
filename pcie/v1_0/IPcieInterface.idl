/**
 * @addtogroup HdiPcie
 * @{
 *
 * @brief Provides PCIe device scanning and driver loading APIs.
 *
 * @since 7.0
 * @version 1.0
 */

/**
 * @file IPcieInterface.idl
 *
 * @brief Declares the PCIe HDI APIs used to get PCIe devices and load matched driver files.
 *
 * @since 7.0
 * @version 1.0
 */

/**
 * @brief Defines the package path of the PCIe HDI APIs.
 *
 * @since 7.0
 * @version 1.0
 */
package ohos.hdi.pcie.v1_0;

import ohos.hdi.pcie.v1_0.PcieTypes;

/**
 * @brief Provides PCIe device scanning and driver loading APIs.
 *
 * @since 7.0
 * @version 1.0
 */
interface IPcieInterface {
    /**
     * @brief Gets PCIe device information from the PCIe host.
     *
     * @param devices PCIe device information returned by the PCIe host. For details, see {@link PcieDeviceInfo}.
     *
     * @return Returns <b>0</b> if the operation is successful.
     * @return Returns <b>-1</b> if the PCIe devices directory cannot be opened.
     *
     * @since 7.0
     * @version 1.0
     */
    GetPcieDevices([out] struct PcieDeviceInfo[] devices);

    /**
     * @brief Loads PCIe driver files based on the specified loading requests.
     *
     * @param loadRequests Driver loading requests. For details, see {@link PcieDriverLoadItem}.
     * @param loadResults Driver loading results for each request. For details, see {@link PcieDriverLoadResult}.
     *
     * @return Returns <b>0</b> if the operation is successful.
     * @return Returns <b>-1</b> if any driver loading request fails.
     *
     * @since 7.0
     * @version 1.0
     */
    LoadPcieDrivers([in] struct PcieDriverLoadItem[] loadRequests,
        [out] struct PcieDriverLoadResult[] loadResults);
}
/** @} */
