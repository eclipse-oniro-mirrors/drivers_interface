/**
 * @file IMediaCryptoModule.idl
 *
 * @brief Defines methods used in ICryptoModule.
 * @since 7.1
 * @version 1.2
 */
 
package ohos.hdi.drm.v1_2;
 
interface ICryptoModule {
    Encrypt([in] String algorithm,[in] unsigned char[] mediaKeyId, [in] unsigned char[] input, [in] unsigned char[] iv, [out] unsigned char[] output);
    Decrypt([in] String algorithm,[in] unsigned char[] mediaKeyId, [in] unsigned char[] input, [in] unsigned char[] iv, [out] unsigned char[] output);
    Sign([in] String algorithm,[in] unsigned char[] mediaKeyId, [in] unsigned char[] message, [out] unsigned char[] signature);
    Verify([in] String algorithm,[in] unsigned char[] mediaKeyId, [in] unsigned char[] message, [in] unsigned char[] signature,[out] boolean success);
    Hmac([in] String algorithm,[in] unsigned char[] mediaKeyId, [in] unsigned char[] message, [out] unsigned char[] mac);
    Release();
};