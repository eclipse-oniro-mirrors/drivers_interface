/**
 * @file MediaKeySystemTypes.idl
 *
 * @brief Defines the types used in HdiDrm.
 * @since 7.1
 * @version 1.2
 */
 
 
package ohos.hdi.drm.v1_2;
import ohos.hdi.drm.v1_1.MediaKeySystemTypes;
 
/**
 * @brief Defines DRM error code type.
 *
 * @since 7.1
 * @version 1.2
 */
enum DrmErrorCode : ohos.hdi.drm.v1_1.DrmErrorCode{
    DRM_ERROR_RESOURCE_BUSY = DRM_ERROR_RESTORE_OFFLINE_MEDIA_KEYS_INNER_ERROR + 1,
    DRM_ERROR_KEY_SESSION_INVALID_STATE,
    DRM_ERROR_RESOURCE_NOT_ENOUGH,
    DRM_ERROR_OEM_ERROR,
    DRM_ERROR_POLICY_GENERAL_ERROR,
    DRM_ERROR_LICENSE_RELEASE_ERROR,
    DRM_ERROR_LICENSE_INVALID_STATE,
    DRM_ERROR_MEDIA_FRAMEWORK_ERROR,
    DRM_ERROR_PROVISIONING_REQUEST_ERROR,
    DRM_ERROR_NO_CERTIFICATE,
    DRM_ERROR_PROVISIONING_RETRY,
};