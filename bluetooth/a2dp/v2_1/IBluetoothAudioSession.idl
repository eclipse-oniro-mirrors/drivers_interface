/*
 * @addtogroup HdiA2dp
 * @{
 *
 * @brief Provides unified APIs for the A2DP service.
 *
 * The Host can use the interface provided by the module to create an audio session,
 * and exchange data with the audio subsystem.
 *
 * @since 7.1
 */

/**
 * @file IBluetoothAudioSession.idl
 *
 * @brief Defines the interfaces to start audio session, send render operation result,
 * and stop the audio session. Extended for multi-device A2DP session support:
 * new methods use ByAddr suffix and peerAddress as an independent parameter.
 *
 * @since 7.1
 * @version 2.1
 */

package ohos.hdi.bluetooth.a2dp.v2_1;

import ohos.hdi.bluetooth.a2dp.v2_0.IBluetoothAudioCallback;
import ohos.hdi.bluetooth.a2dp.v2_0.BluetoothAudioTypes;
import ohos.hdi.bluetooth.a2dp.v2_0.IBluetoothAudioSession;

/**
 * @brief Defines the interfaces to start audio session, send render operation result,
 * and stop the audio session. Extended for multi-device A2DP session support:
 * new methods use ByAddr suffix and peerAddress as an independent parameter.
 *
 * @since 7.1
 * @version 2.1
 */
interface IBluetoothAudioSession extends ohos.hdi.bluetooth.a2dp.v2_0.IBluetoothAudioSession {
    /**
     * @brief Start audio session with peer address for multi-device support.
     *
     * @param params Indicates the start session parameters. For details, see {@link BluetoothAudioTypes}.
     * @param callbackObj Indicates the callback function. For details, see {@link IBluetoothAudioCallback}.
     * @param peerAddress Indicates the peer device address for multi-device routing.
     * @param queue Returns sharedMemQueue for audio data.
     * @return Returns <b>0</b> if the operation is successfully; returns a negative value otherwise.
     *
     * @since 7.1
     * @version 2.1
     */
    StartSessionByAddr([in] struct StartSessionParams params,
        [in] IBluetoothAudioCallback callbackObj,
        [in] String peerAddress,
        [out] SharedMemQueue<unsigned char> queue);

    /**
     * @brief Stop audio session for specific peer device.
     *
     * @param sessionType Indicates the session type.
     * @param peerAddress Indicates the peer device address.
     * @return Returns <b>0</b> if the operation is successfully; returns a negative value otherwise.
     *
     * @since 7.1
     * @version 2.1
     */
    StopSessionByAddr([in] enum SessionType sessionType, [in] String peerAddress);

    /**
     * @brief Send the render operation result for specific peer device.
     *
     * @param operation Indicates the render operation.
     * @param status SUCCESS or FAILURE for operation.
     * @param peerAddress Indicates the peer device address.
     * @return Returns <b>0</b> if the operation is successfully; returns a negative value otherwise.
     *
     * @since 7.1
     * @version 2.1
     */
    RenderOperationResultByAddr([in] enum Operation operation,
        [in] enum Status status, [in] String peerAddress);
}
