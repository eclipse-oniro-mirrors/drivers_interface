package ohos.hdi.codec.v4_1;
import ohos.hdi.codec.v4_0.ICodecComponentManager;
sequenceable ohos.hdi.codec.ParcelableBuffer;

/**
 * @brief Defines the APIs for managing the codec components.
 *
 * The APIs can be used to:
 * - Obtain the number of codec components and codec capabilities.
 * - Create or destroy a codec component.
 * @since 7.1
 * @version 4.1
 */
interface ICodecComponentManager extends ohos.hdi.codec.v4_0.ICodecComponentManager {
    /**
     * @brief Query if decoder support the xps data.
     * @param mime Indicates the protocol to be query.
     * @param xps Indicates the xps buffer.
     * @param isSupport Indicates the query result.
     *
     * @return Returns <b>HDF_SUCCESS</b> if the operation is successful.
     * @return Returns <b>HDF_FAILURE</b> if the execution fails.
     * @return Returns other values if the underlying layer returns a failure. For details about the error codes,
     * see <b>OMX_ERRORTYPE</b> defined by OpenMAX IL.
     *
     * @since 7.1
     * @version 4.1
     */
    QueryIfDecoderSupportThisXPS([in] String mime, [in] ParcelableBuffer xps, [out] boolean isSupport);
}